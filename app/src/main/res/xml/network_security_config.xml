<?xml version="1.0" encoding="utf-8"?>
<!--
  Every link this app opens is a raw TCP or UDP socket on a private local network: HSFZ on 6801,
  DoIP on 13400, an ELM327 dongle on 35000. Raw sockets are not governed by this policy at all,
  and the app makes no HTTP requests, so cleartext is permitted only so that a future local
  adapter web endpoint would work. There is no traffic to any public host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
