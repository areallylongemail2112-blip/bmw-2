<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Real ECU coding/diagnostics needs the local network (ENET/HSFZ, DoIP, OBD-WiFi). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Inbound gateway discovery replies are broadcast; many Wi-Fi chipsets filter those
         without a multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- OBD adapters. On Android 12+ BLUETOOTH_SCAN/CONNECT replace the legacy permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-Android-12 BLE scanning requires location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Both optional: an ENET cable needs no Bluetooth at all. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".BmwAssistantApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.BmwAssistant">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".feature.coding.CodingModulesActivity" android:exported="false" />
        <activity android:name=".feature.coding.CodingListActivity" android:exported="false" />
        <activity android:name=".feature.coding.EditCodingActivity" android:exported="false" />
        <activity android:name=".feature.diagnostics.DiagnosticsModulesActivity" android:exported="false" />
        <activity android:name=".feature.diagnostics.DiagnosticsModuleActivity" android:exported="false" />
        <activity
            android:name=".feature.connection.ConnectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".feature.backups.BackupsActivity" android:exported="false" />
    </application>
</manifest>
