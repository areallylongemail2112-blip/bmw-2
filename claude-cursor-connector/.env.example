# Required for remote HTTP when you want a shared service-account Cursor key.
# Mint at https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=cursor_...

# Public URL Claude will use to reach this server, including the /mcp path
# if that is what users enter in Customize → Connectors.
# Example: https://cursor-connector.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Listen address for --http
HOST=0.0.0.0
PORT=8787

# Optional shared secret. When set, Claude can send:
#   Authorization: Bearer <CONNECTOR_AUTH_TOKEN>
# or x-api-key: <CONNECTOR_AUTH_TOKEN>
# and the server will use CURSOR_API_KEY for Cursor API calls.
CONNECTOR_AUTH_TOKEN=

# Allow unauthenticated MCP calls that use CURSOR_API_KEY from the environment.
# Only enable this on a private network. Default: false for HTTP, true for stdio.
ALLOW_UNAUTHENTICATED=false

# Persist OAuth clients/tokens across restarts (JSON file).
OAUTH_STORE_PATH=.oauth-store.json

# Access token lifetime in seconds (default 8 hours).
OAUTH_ACCESS_TTL_SECONDS=28800

# Refresh token lifetime in seconds (default 30 days).
OAUTH_REFRESH_TTL_SECONDS=2592000
